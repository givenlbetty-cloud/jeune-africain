# Configuration et Variables d'Environnement - Paiements

## Stripe Configuration
STRIPE_API_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET_HERE

## PayPal Configuration
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox  # 'sandbox' pour test, 'live' pour production
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

## Mobile Money Configurations

### Airtel Money
AIRTEL_API_KEY=YOUR_AIRTEL_API_KEY
AIRTEL_API_SECRET=YOUR_AIRTEL_API_SECRET
AIRTEL_MERCHANT_ID=YOUR_MERCHANT_ID
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/payments/airtel/callback/

### M-Pesa (Safaricom)
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_ENVIRONMENT=sandbox  # 'sandbox' ou 'production'

### Orange Money (RDC)
ORANGE_MONEY_API_KEY=YOUR_ORANGE_API_KEY
ORANGE_MONEY_API_SECRET=YOUR_ORANGE_API_SECRET
ORANGE_MONEY_MERCHANT_ID=YOUR_MERCHANT_ID

## Bank Transfer Configuration
BANK_ACCOUNT_HOLDER=BNC Digital Library
BANK_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
BANK_ROUTING_NUMBER=YOUR_ROUTING_NUMBER
BANK_ACCOUNT_TYPE=checking  # ou 'savings'

## General Payment Settings
PAYMENT_CURRENCY_DEFAULT=XOF
PAYMENT_SUCCESS_REDIRECT=https://yourdomain.com/payment/success/
PAYMENT_CANCEL_REDIRECT=https://yourdomain.com/payment/cancel/
PAYMENT_WEBHOOK_TIMEOUT=30

## Environment
DEBUG=False  # Important: False en production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

## Database (Ensure HTTPS in production)
DATABASE_URL=postgresql://user:password@localhost:5432/bnc_db

## Email Configuration (Pour notifications paiement)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

## Logging
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
