# ============================================================================
# DJANGO & APPLICATION SETTINGS
# ============================================================================
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_URL=http://localhost:8000
PLATFORM_DOMAIN=calures.com
CONTACT_EMAIL=contact@calures.com
AUDIOBOOK_PRICE_PERCENT=100

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (development - default)
# PostgreSQL (production - recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/bnc_db

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ============================================================================
# GOOGLE OAUTH 2.0
# ============================================================================
# Get from: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your-client-secret

# ============================================================================
# APPLE SIGN IN
# ============================================================================
# Get from: https://developer.apple.com/account/
APPLE_OAUTH_CLIENT_ID=com.yourcompany.bnc
APPLE_OAUTH_SECRET=your-apple-client-secret
APPLE_TEAM_ID=XXXXXXXXXX

# ============================================================================
# MICROSOFT OAUTH 2.0
# ============================================================================
# Get from: https://portal.azure.com/ (Azure App Registration)
MICROSOFT_OAUTH_CLIENT_ID=your-client-id
MICROSOFT_OAUTH_SECRET=your-client-secret
MICROSOFT_TENANT=common  # or your specific tenant ID

# ============================================================================
# STRIPE PAYMENT
# ============================================================================
# Get from: https://stripe.com/
STRIPE_API_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# ============================================================================
# PAYPAL PAYMENT
# ============================================================================
# Get from: https://developer.paypal.com/
# PAYPAL_MODE can be 'sandbox' (testing) or 'live' (production)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# ============================================================================
# MONEROO PAYMENT
# ============================================================================
# Set MONEROO_MODE=sandbox for testing or MONEROO_MODE=live for production.
# If your Moneroo dashboard requires a dedicated sandbox URL, set MONEROO_API_URL explicitly.
MONEROO_MODE=sandbox
MONEROO_API_KEY=your_moneroo_api_key
MONEROO_PUBLIC_KEY=your_moneroo_api_key
MONEROO_SECRET_KEY=your_moneroo_secret_key
MONEROO_WEBHOOK_SECRET=your_moneroo_secret_key
MONEROO_API_URL=https://api.moneroo.io/v1
USE_MONEROO_FOR_ALL=True

# ============================================================================
# MOBILE MONEY GATEWAYS
# ============================================================================

# AIRTEL MONEY (West Africa)
# Get from: https://www.airtelmoneyadmin.com/
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_PIN=your_airtel_pin

# M-PESA (Kenya & Africa)
# Get from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_mpesa_passkey

# ORANGE MONEY (Central Africa - RDC)
# Get from: https://developer.orange.com/
ORANGE_MONEY_API_KEY=your_orange_api_key
ORANGE_MONEY_API_SECRET=your_orange_api_secret

# ============================================================================
# MONEROO PAYMENT (Mobile Money & Cartes — RDC)
# ============================================================================
# Clés depuis : https://app.moneroo.io/ > Developers > API Keys
# Utilisez la clé secrète (secret key) pour MONEROO_API_KEY
MONEROO_API_KEY=
MONEROO_SECRET_KEY=
USE_MONEROO_FOR_ALL=True
# CDF en production ; USD obligatoire avec Test Payment Gateway (Sandbox) Moneroo
MONEROO_CURRENCY=CDF

# ============================================================================
# PAYMENT & BUSINESS SETTINGS
# ============================================================================
DEFAULT_CURRENCY=XOF
PAYMENT_TIMEOUT_MINUTES=30
FREE_PREVIEW_PAGES=30

# ============================================================================
# SECURITY (Production only)
# ============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ============================================================================
# AWS S3 (Optional - for file storage)
# ============================================================================
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# CELERY (Optional - for async tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
