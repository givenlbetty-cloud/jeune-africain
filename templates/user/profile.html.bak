{% extends 'base.html' %}

{% block title %}Profil - BNC{% endblock %}

{% block content %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    {% if user.avatar %}
                        <img src="{{ user.avatar.url }}" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                    {% else %}
                        <div class="mb-3">
                            <i class="fas fa-user-circle" style="font-size: 150px; color: #ccc;"></i>
                        </div>
                    {% endif %}
                    <h4>{{ user.first_name }} {{ user.last_name }}</h4>
                    <p class="text-muted">@{{ user.username }}</p>
                    
                    <div class="mt-4">
                        <p><strong>{{ total_readings }}</strong> lectures</p>
                        <p><strong>{{ total_books_read }}</strong> livres lus</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-9">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Informations Personnelles</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% csrf_token %}
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Prénom</label>
                                <input type="text" name="first_name" class="form-control" value="{{ user.first_name }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nom</label>
                                <input type="text" name="last_name" class="form-control" value="{{ user.last_name }}">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="{{ user.email }}" disabled>
                                <small class="text-muted">Non modifiable</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Téléphone</label>
                                <input type="tel" name="phone" class="form-control" value="{{ user.phone|default:'' }}">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Ville</label>
                                <input type="text" name="city" class="form-control" value="{{ user.city|default:'' }}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Pays</label>
                                <input type="text" name="country" class="form-control" value="{{ user.country|default:'' }}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Adresse</label>
                                <input type="text" name="address" class="form-control" value="{{ user.address|default:'' }}">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Avatar</label>
                            <input type="file" name="avatar" class="form-control" accept="image/*">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Statut d'abonnement</label>
                            <div class="alert alert-info">
                                {{ user.get_subscription_status_display }}
                                {% if user.subscription_end_date %}
                                    - Expire le {{ user.subscription_end_date|date:"d/m/Y" }}
                                {% endif %}
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                    </form>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Compte</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Compte créé</span>
                            <strong>{{ user.date_joined|date:"d/m/Y" }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Rôle</span>
                            <strong>{{ user.get_role_display }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Statut</span>
                            {% if user.is_active %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger">Inactif</span>
                            {% endif %}
                        </li>
                    </ul>
                    
                    <div class="mt-3">
                        <a href="{% url 'users:payment_history' %}" class="btn btn-outline-primary me-2">
                            Historique paiements
                        </a>
                        <a href="{% url 'users:reading_history' %}" class="btn btn-outline-primary">
                            Historique téléchargements
                        </a>
                        <a href="{% url 'users:favorite_list' %}" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-heart"></i> Mes favoris
                        </a>
                        <a href="{% url 'users:highlight_list' %}" class="btn btn-outline-info ms-2">
                            <i class="fas fa-highlighter"></i> Mes Surlignages
                        </a>
                        <a href="{% url 'users:note_list' %}" class="btn btn-outline-warning ms-2">
                            <i class="fas fa-sticky-note"></i> Mes Notes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
