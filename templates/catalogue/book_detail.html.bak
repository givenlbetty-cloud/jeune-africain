{% extends 'base-premium.html' %}
{% load static %}

{% block title %}{{ book.title }} - BNC{% endblock %}

{% block content %}
<div class="container mt-4 mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item"><a href="{% url 'home' %}"><i class="fas fa-home"></i> Accueil</a></li>
            <li class="breadcrumb-item"><a href="{% url 'catalogue:catalogue' %}">Catalogue</a></li>
            <li class="breadcrumb-item active">{{ book.title|truncatewords:3 }}</li>
        </ol>
    </nav>
    
    <!-- Book Header -->
    <div class="row g-4 mb-4">
        <!-- Cover & Actions (Left Column - Mobile Full Width) -->
        <div class="col-12 col-lg-4">
            <div style="position: sticky; top: 80px;">
                <div class="card-premium">
                    <div class="book-cover" style="height: 350px;">
                        {% if book.cover %}
                            <img src="{{ book.cover.url }}" alt="{{ book.title }}" style="border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
                        {% else %}
                            <div class="book-cover-placeholder" style="font-size: 5rem;">
                                <i class="fas fa-book"></i>
                            </div>
                        {% endif %}
                    </div>
                    <div style="padding: 1.5rem;">
                        <!-- Book Stats -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; padding: 1rem; background: rgba(91, 95, 241, 0.05); border-radius: var(--radius-md);">
                            <div style="text-align: center;">
                                <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary);">{{ book.views_count|default:0 }}</div>
                                <small style="color: var(--text-light);">Lectures</small>
                            </div>
                            <div style="text-align: center;">
                                <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent);">{{ book.favorites_count|default:0 }}</div>
                                <small style="color: var(--text-light);">Favoris</small>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            {% if not book.is_paid or has_access %}
                                <a href="{% url 'catalogue:read_book' book_id=book.pk %}" class="btn btn-premium w-100">
                                    <i class="fas fa-book-open"></i> Lire le livre
                                </a>
                                {% if user.is_authenticated %}
                                <button type="button" class="btn btn-secondary-premium w-100" onclick="saveForOffline('{{ book.pk }}', '{{ book.get_file_url|safe }}')" id="offlineBtn">
                                    <i class="fas fa-cloud-download-alt"></i> <span id="offlineText">Sauvegarder hors-ligne</span>
                                </button>
                                {% endif %}
                            {% else %}
                                {% if has_free_preview %}
                                    <a href="{% url 'catalogue:read_book' book_id=book.pk %}" class="btn btn-secondary-premium w-100">
                                        <i class="fas fa-eye"></i> Lire l'extrait gratuit ({{ free_pages_count }} pages)
                                    </a>
                                {% endif %}
                                <a href="{% url 'catalogue:initiate_payment' book_id=book.pk %}" class="btn btn-premium w-100">
                                    <i class="fas fa-shopping-cart"></i> Acheter ({{ book.price|floatformat:0 }} FC)
                                </a>
                            {% endif %}
                            {% if user.is_authenticated %}
                            <button type="button" class="btn btn-secondary-premium w-100" onclick="toggleFavorite(event, {{ book.pk }})" id="favBtn">
                                <i class="fas fa-heart"></i> <span id="favText">Ajouter aux favoris</span>
                            </button>
                            {% else %}
                            <a href="{% url 'users:login' %}" class="btn btn-secondary-premium w-100">
                                <i class="fas fa-sign-in-alt"></i> Se connecter
                            </a>
                            {% endif %}
                            {% if book.in_library %}
                            <div style="padding: 0.75rem; background: #10B981; color: white; border-radius: var(--radius-md); text-align: center; font-weight: 600;">
                                <i class="fas fa-check-circle"></i> Dans votre bibliothèque
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Book Details (Right Column - Mobile Below) -->
        <div class="col-12 col-lg-8">
            <!-- Title & Rating -->
            <div class="mb-4">
                <h1 style="font-size: clamp(1.75rem, 5vw, 2.25rem); margin-bottom: 0.5rem;">{{ book.title }}</h1>
                <p style="font-size: 1.1rem; color: var(--text-light); margin-bottom: 1rem;">par <strong>{{ book.author }}</strong></p>
                
                <!-- Rating -->
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: #FFD700;">
                            {% for i in "12345" %}
                                {% if book.rating >= i %}
                                    <i class="fas fa-star"></i>
                                {% elif book.rating > i|add:'-1' %}
                                    <i class="fas fa-star-half-alt"></i>
                                {% else %}
                                    <i class="fas fa-star empty"></i>
                                {% endif %}
                            {% endfor %}
                        </span>
                        <strong>{{ book.rating|default:"0" }}/5</strong>
                    </div>
                    <span style="color: var(--text-light);">({{ book.reviews_count|default:0 }} avis)</span>
                </div>
                
                <!-- Tags -->
                {% if book.category or book.language %}
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    {% if book.category %}
                    <span class="badge" style="background: rgba(91, 95, 241, 0.2); color: var(--primary); padding: 0.5rem 1rem;">
                        <i class="fas fa-tag"></i> {{ book.category }}
                    </span>
                    {% endif %}
                    {% if book.language %}
                    <span class="badge" style="background: rgba(0, 212, 255, 0.2); color: var(--secondary-dark); padding: 0.5rem 1rem;">
                        <i class="fas fa-globe"></i> {{ book.language }}
                    </span>
                    {% endif %}
                    {% if book.is_premium %}
                    <span class="badge" style="background: rgba(255, 107, 107, 0.2); color: var(--accent); padding: 0.5rem 1rem;">
                        <i class="fas fa-crown"></i> Premium
                    </span>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            
            <!-- Metadata Grid -->
            <div class="card-premium mb-4">
                <div style="padding: 1.5rem;">
                    <h5 class="mb-3" style="font-weight: 700;"><i class="fas fa-info-circle"></i> Informations</h5>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        {% if book.isbn %}
                        <div>
                            <small style="color: var(--text-light);">ISBN</small>
                            <p style="margin: 0; font-weight: 600;">{{ book.isbn }}</p>
                        </div>
                        {% endif %}
                        {% if book.publication_date %}
                        <div>
                            <small style="color: var(--text-light);">Date de publication</small>
                            <p style="margin: 0; font-weight: 600;">{{ book.publication_date|date:"d M Y" }}</p>
                        </div>
                        {% endif %}
                        {% if book.pages %}
                        <div>
                            <small style="color: var(--text-light);">Pages</small>
                            <p style="margin: 0; font-weight: 600;">{{ book.pages }}</p>
                        </div>
                        {% endif %}
                        <div>
                            <small style="color: var(--text-light);">Statut</small>
                            <p style="margin: 0; font-weight: 600;">
                                {% if book.is_available %}
                                    <i class="fas fa-check-circle" style="color: var(--success);"></i> Disponible
                                {% else %}
                                    <i class="fas fa-times-circle" style="color: var(--danger);"></i> Indisponible
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Description -->
    {% if book.description %}
    <div class="card-premium mb-4">
        <div style="padding: 1.5rem;">
            <h5 class="mb-3" style="font-weight: 700;"><i class="fas fa-align-left"></i> Synopsis</h5>
            <p style="line-height: 1.8; color: var(--text-light);">{{ book.description }}</p>
        </div>
    </div>
    {% endif %}
    
    <!-- Author Bio -->
    {% if book.author_bio or book.author %}
    <div class="card-premium mb-4">
        <div style="padding: 1.5rem;">
            <h5 class="mb-3" style="font-weight: 700;"><i class="fas fa-user-circle"></i> À propos de l'auteur</h5>
            <div style="display: flex; gap: 1rem;">
                <div style="flex-shrink: 0;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem;">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div style="flex-grow: 1;">
                    <h6 style="font-weight: 700;">{{ book.author }}</h6>
                    <p style="margin: 0; color: var(--text-light);">{{ book.author_bio|default:"Auteur de talent des éditions BNC" }}</p>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    
    <!-- Reviews Section -->
    <div class="card-premium mb-4">
        <div style="padding: 1.5rem;">
            <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-comments"></i> Avis des lecteurs</h5>
            
            {% if user.is_authenticated %}
            <!-- Add Review Form -->
            <div style="margin-bottom: 2rem; padding: 1.5rem; background: rgba(91, 95, 241, 0.05); border-radius: var(--radius-md);">
                <h6 style="font-weight: 700; margin-bottom: 1rem;"><i class="fas fa-pen"></i> Laisser un avis</h6>
                <form method="POST" action="{% url 'catalogue:add_review' book.pk %}" style="display: flex; flex-direction: column; gap: 1rem;">
                    {% csrf_token %}
                    <div>
                        <label class="form-label">Note</label>
                        <div style="display: flex; gap: 0.5rem; font-size: 1.5rem;">
                            {% for i in "12345" %}
                            <label style="cursor: pointer; color: #DDD;">
                                <input type="radio" name="rating" value="{{ i }}" style="display: none;">
                                <i class="fas fa-star" onclick="setRating({{ i }})"></i>
                            </label>
                            {% endfor %}
                        </div>
                    </div>
                    <div>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Partagez votre avis..." style="border-radius: var(--radius-md);"></textarea>
                    </div>
                    <button type="submit" class="btn btn-premium">
                        <i class="fas fa-paper-plane"></i> Publier mon avis
                    </button>
                </form>
            </div>
            {% endif %}
            
            <!-- Reviews List -->
            {% if book.reviews.all %}
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    {% for review in book.reviews.all %}
                    <div style="padding: 1rem; background: var(--light); border-radius: var(--radius-md); border-left: 4px solid var(--primary);">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
                            <div>
                                <strong>{{ review.user.get_full_name|default:review.user.username }}</strong>
                                <div style="color: #FFD700; font-size: 0.9rem;">
                                    {% for i in "12345" %}
                                        {% if review.rating >= i %}
                                            <i class="fas fa-star"></i>
                                        {% else %}
                                            <i class="fas fa-star empty"></i>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <small style="color: var(--text-light);">{{ review.created_at|date:"d M Y" }}</small>
                        </div>
                        <p style="margin: 0; color: var(--text-light);">{{ review.comment }}</p>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <div style="text-align: center; padding: 2rem; color: var(--text-light);">
                    <i class="fas fa-comment-slash" style="font-size: 2rem; opacity: 0.3; display: block; margin-bottom: 1rem;"></i>
                    <p>Aucun avis pour le moment. Soyez le premier!</p>
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Related Books -->
    {% if related_books %}
    <div class="mb-4">
        <h4 style="font-weight: 700; margin-bottom: 1.5rem;"><i class="fas fa-book-reader"></i> Livres similaires</h4>
        <div class="row g-3">
            {% for related_book in related_books %}
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <a href="{% url 'catalogue:book_detail' book_id=related_book.pk %}" class="book-card-premium">
                    <div class="book-cover">
                        {% if related_book.cover %}
                            <img src="{{ related_book.cover.url }}" alt="{{ related_book.title }}">
                        {% else %}
                            <div class="book-cover-placeholder">
                                <i class="fas fa-book"></i>
                            </div>
                        {% endif %}
                    </div>
                    <div class="book-info">
                        <h6 class="book-title">{{ related_book.title }}</h6>
                        <p class="book-author" style="font-size: 0.8rem;">{{ related_book.author|truncatewords:3 }}</p>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

<script>
function setRating(rating) {
    document.querySelector(`input[value="${rating}"]`).checked = true;
    const stars = document.querySelectorAll('label i.fa-star');
    stars.forEach((star, index) => {
        if (index < rating) {
            star.style.color = '#FFD700';
        } else {
            star.style.color = '#DDD';
        }
    });
}

function toggleFavorite(event, bookId) {
    event.preventDefault();
    const btn = document.getElementById('favBtn');
    const text = document.getElementById('favText');
    
    const url = `/users/toggle-favorite/${bookId}/`;
    fetch(url, {
        method: 'POST',
        headers: {
            'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]')?.value || '',
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.favorited) {
            btn.style.background = 'linear-gradient(135deg, #FF6B6B, #FF4757)';
            btn.style.borderColor = '#FF4757';
            btn.style.color = 'white';
            text.textContent = 'En favori';
        } else {
            btn.style.background = 'rgba(91, 95, 241, 0.1)';
            btn.style.borderColor = 'var(--primary)';
            btn.style.color = 'var(--primary)';
            text.textContent = 'Ajouter aux favoris';
        }
    });
}

async function saveForOffline(bookId, pdfUrl) {
    if (!pdfUrl || pdfUrl === 'None') {
        alert("Le fichier PDF n'est pas disponible.");
        return;
    }
    
    const btn = document.getElementById('offlineBtn');
    const text = document.getElementById('offlineText');
    const icon = btn.querySelector('i');
    
    icon.className = 'fas fa-spinner fa-spin';
    text.textContent = 'Sauvegarde en cours...';
    btn.disabled = true;
    
    try {
        // Fetch the PDF as a blob
        const response = await fetch(pdfUrl);
        if (!response.ok) throw new Error('Network response was not ok');
        const blob = await response.blob();
        
        // Save to IndexedDB
        const dbName = 'BNC_OfflineBooks';
        const request = indexedDB.open(dbName, 1);
        
        request.onupgradeneeded = function(event) {
            const db = event.target.result;
            if (!db.objectStoreNames.contains('books')) {
                db.createObjectStore('books', { keyPath: 'id' });
            }
        };
        
        request.onsuccess = function(event) {
            const db = event.target.result;
            const transaction = db.transaction(['books'], 'readwrite');
            const store = transaction.objectStore('books');
            
            store.put({
                id: bookId,
                blob: blob,
                timestamp: new Date().getTime()
            });
            
            transaction.oncomplete = function() {
                icon.className = 'fas fa-check-circle';
                text.textContent = 'Sauvegardé hors-ligne';
                btn.style.background = 'var(--success)';
                btn.style.color = 'white';
                btn.style.borderColor = 'var(--success)';
            };
            
            transaction.onerror = function() {
                throw new Error('Transaction failed');
            };
        };
        
        request.onerror = function() {
            throw new Error('IndexedDB error');
        };
        
    } catch (error) {
        console.error('Error saving offline:', error);
        icon.className = 'fas fa-exclamation-triangle';
        text.textContent = 'Erreur de sauvegarde';
        btn.disabled = false;
        setTimeout(() => {
            icon.className = 'fas fa-cloud-download-alt';
            text.textContent = 'Sauvegarder hors-ligne';
        }, 3000);
    }
}
</script>

{% endblock %}
