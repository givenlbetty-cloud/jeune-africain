{% extends "base.html" %}
{% load i18n %}

{% block title %}Audiobooks - BNC{% endblock %}

{% block content %}
<style>
    /* YouTube-like Styles */
    .media-container {
        padding: 20px 40px;
        background-color: #f9f9f9;
        min-height: 100vh;
    }
    
    .media-header {
        margin-bottom: 30px;
    }
    
    .chip-container {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }
    
    .chip {
        background: #0000000d;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        border: 1px solid transparent;
        transition: background 0.2s;
        text-decoration: none;
        color: var(--text-primary);
    }
    
    .chip:hover {
        background: #0000001a;
        color: var(--text-primary);
    }
    
    .chip.active {
        background: var(--text-primary);
        color: white;
    }

    .media-card {
        border: none;
        background: transparent;
        margin-bottom: 30px;
        cursor: pointer;
    }
    
    .media-thumbnail {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 16/9; /* Standard video format */
        background: #e0e0e0;
        margin-bottom: 12px;
    }
    
    .media-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s;
    }
    
    .media-card:hover .media-thumbnail img {
        transform: scale(1.02);
    }
    
    .duration-badge {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 3px 6px;
        font-size: 0.75rem;
        border-radius: 4px;
        font-weight: 500;
    }
    
    .media-info {
        display: flex;
        gap: 12px;
    }
    
    .media-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #ccc;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.8rem;
    }
    
    .media-details {
        flex: 1;
    }
    
    .media-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--text-primary);
    }
    
    .media-meta {
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.3;
    }
</style>

<div class="media-container">
    <!-- Header / Chips -->
    <div class="chip-container">
        <a href="?cat=all" class="chip active">Tout</a>
        <a href="?cat=education" class="chip">Éducation</a>
        <a href="?cat=roman" class="chip">Romans</a>
        <a href="?cat=religion" class="chip">Religion</a>
        <a href="?cat=history" class="chip">Histoire</a>
        <a href="?cat=sciences" class="chip">Sciences</a>
    </div>

    <!-- Media Grid -->
    {% if audiobooks %}
    <div class="row">
        {% for audiobook in audiobooks %}
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="media-card" onclick="window.location.href='{% url 'catalogue:audiobook_detail' audiobook.id %}'">
                <div class="media-thumbnail">
                    {% if audiobook.cover_url %}
                        <img src="{{ audiobook.cover_url }}" alt="{{ audiobook.title }}">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white">
                            <i class="fas fa-headphones fa-3x"></i>
                        </div>
                    {% endif %}
                    <span class="duration-badge">{{ audiobook.duration_minutes|default:"--" }}:00</span>
                </div>
                
                <div class="media-info">
                    <div class="media-avatar bg-primary">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="media-details">
                        <h3 class="media-title">{{ audiobook.title }}</h3>
                        <div class="media-meta">
                            {{ audiobook.author.name }}<br>
                            {{ audiobook.views|default:"0" }} vues • Il y a 2 jours
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-5">
        <i class="fas fa-headphones fa-4x text-muted mb-3"></i>
        <h3>Aucun audiobook trouvé</h3>
        <p class="text-muted">Essayez une autre recherche.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
