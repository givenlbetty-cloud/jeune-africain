{% extends 'base-premium.html' %}

{% block title %}Événements - BNC{% endblock %}

{% block content %}
<div class="container mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 style="font-weight: 800; font-size: 1.15rem; margin: 0;"><i class="fas fa-bullhorn" style="color: var(--primary);"></i> Événements &amp; Annonces</h2>
            <p style="color: var(--text-light); font-size: 0.78rem; margin: 0;">Nouveautés, ateliers et conférences</p>
        </div>
        <form method="get" style="min-width: 160px;">
            <select name="type" class="form-select form-select-sm" onchange="this.form.submit()" style="font-size: 0.8rem;">
                <option value="">Tous</option>
                {% for value, label in event_types %}
                    <option value="{{ value }}" {% if selected_type == value %}selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
        </form>
    </div>

    {% if happening_now %}
    <div class="mb-3">
        <h5 class="mb-2" style="font-weight: 700; font-size: 0.95rem;"><i class="fas fa-bolt" style="color: var(--warning);"></i> En cours</h5>
        <div class="row g-2">
            {% for event in happening_now %}
            <div class="col-6 col-md-4 col-lg-3 mb-2">
                <div class="card-premium" style="overflow: hidden;">
                    {% if event.image %}
                    <img src="{{ event.image.url }}" alt="{{ event.title }}" style="height: 100px; width: 100%; object-fit: cover;">
                    {% else %}
                    <div style="height: 100px; background: linear-gradient(135deg, var(--warning), #F59E0B); display: flex; align-items: center; justify-content: center;"><i class="fas fa-calendar-alt" style="font-size: 1.5rem; color: white; opacity: 0.5;"></i></div>
                    {% endif %}
                    <div style="padding: 0.5rem;">
                        <span class="badge" style="background: var(--warning); color: #000; font-size: 0.55rem; margin-bottom: 0.25rem;">{{ event.get_event_type_display }}</span>
                        <h6 style="font-size: 0.75rem; font-weight: 700; margin: 0.2rem 0; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ event.title }}</h6>
                        <p style="font-size: 0.65rem; color: var(--text-light); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ event.description|truncatewords:12 }}</p>
                        <p style="font-size: 0.6rem; color: var(--text-light); margin: 0.25rem 0 0;"><i class="fas fa-clock"></i> {{ event.date_start|date:"d M Y" }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if upcoming_events %}
    <div class="mb-3">
        <h5 class="mb-2" style="font-weight: 700; font-size: 0.95rem;"><i class="fas fa-clock" style="color: var(--primary);"></i> À venir</h5>
        <div class="row g-2">
            {% for event in upcoming_events %}
            <div class="col-6 col-md-4 col-lg-3 mb-2">
                <div class="card-premium" style="overflow: hidden;">
                    {% if event.image %}
                    <img src="{{ event.image.url }}" alt="{{ event.title }}" style="height: 100px; width: 100%; object-fit: cover;">
                    {% else %}
                    <div style="height: 100px; background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center;"><i class="fas fa-calendar-alt" style="font-size: 1.5rem; color: white; opacity: 0.5;"></i></div>
                    {% endif %}
                    <div style="padding: 0.5rem;">
                        <span class="badge" style="background: var(--primary); color: white; font-size: 0.55rem; margin-bottom: 0.25rem;">{{ event.get_event_type_display }}</span>
                        <h6 style="font-size: 0.75rem; font-weight: 700; margin: 0.2rem 0; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ event.title }}</h6>
                        <p style="font-size: 0.65rem; color: var(--text-light); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ event.description|truncatewords:12 }}</p>
                        <p style="font-size: 0.6rem; color: var(--text-light); margin: 0.25rem 0 0;"><i class="fas fa-clock"></i> {{ event.date_start|date:"d M Y" }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if past_events %}
    <div class="mb-3">
        <h5 class="mb-2" style="font-weight: 700; font-size: 0.95rem; color: var(--text-light);"><i class="fas fa-history"></i> Passés</h5>
        <div class="row g-2">
            {% for event in past_events %}
            <div class="col-6 col-md-4 col-lg-3 mb-2">
                <div class="card-premium" style="overflow: hidden; opacity: 0.7;">
                    {% if event.image %}
                    <img src="{{ event.image.url }}" alt="{{ event.title }}" style="height: 100px; width: 100%; object-fit: cover; filter: grayscale(30%);">
                    {% else %}
                    <div style="height: 100px; background: linear-gradient(135deg, #6B7280, #9CA3AF); display: flex; align-items: center; justify-content: center;"><i class="fas fa-calendar-alt" style="font-size: 1.5rem; color: white; opacity: 0.5;"></i></div>
                    {% endif %}
                    <div style="padding: 0.5rem;">
                        <span class="badge" style="background: #6B7280; color: white; font-size: 0.55rem; margin-bottom: 0.25rem;">{{ event.get_event_type_display }}</span>
                        <h6 style="font-size: 0.75rem; font-weight: 700; margin: 0.2rem 0; line-height: 1.2; color: var(--text-light); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ event.title }}</h6>
                        <p style="font-size: 0.6rem; color: var(--text-light); margin: 0;"><i class="fas fa-clock"></i> {{ event.date_start|date:"d M Y" }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if not all_events %}
    <div style="text-align: center; padding: 2rem 1rem; border-radius: var(--radius-md); background: var(--light); border: 2px dashed var(--border);">
        <i class="fas fa-calendar-alt" style="font-size: 2rem; color: var(--text-light); opacity: 0.5; margin-bottom: 0.5rem; display: block;"></i>
        <h5 style="font-weight: 700;">Aucun événement</h5>
        <p style="color: var(--text-light); font-size: 0.8rem;">Revenez bientôt pour les annonces et ateliers!</p>
    </div>
    {% endif %}
</div>

{% endblock %}
